# Model API configuration
# OpenRouter is selected automatically when this key is set.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Shared sign-in for the private chat. Use separate random values (32+ characters).
CHAT_ACCESS_PASSWORD=CHANGE_ME
CHAT_SESSION_SECRET=CHANGE_ME
# Required in addition to chat sign-in for source upload, listing, preview, and deletion.
SOURCE_ADMIN_TOKEN=CHANGE_ME

# Qdrant Cloud or self-hosted Qdrant; API key may be omitted for local self-hosted instances.
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
# Optional; defaults to uploaded_sources
# QDRANT_COLLECTION=uploaded_sources
# Optional comma-separated exact origins for cross-origin clients. Same-origin is the default.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Optional; defaults to https://openrouter.ai/api/v1
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Changing the embedding model requires rebuilding the vector stores.
# LLM_MODEL=openai/gpt-4o-mini
# EMBEDDING_MODEL=openai/text-embedding-ada-002

# Legacy OpenAI settings remain supported for existing deployments.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_BASE=https://api.openai.com/v1
LANGFUSE_PUBLIC_KEY=langfuse_public_key
LANGFUSE_SECRET_KEY=langfuse_secret_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_HOST is also accepted as a legacy alias for LANGFUSE_BASE_URL.

